# Optional. If unset, the app uses an in-memory Postgres (fine for local demo).
# For a real deploy (Vercel), set a Neon / Postgres URL so pre-orders persist.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Leave unset (or true) to keep Sign in with Grok available.
# Set to false for a simpler public site with no login.
# VITE_AUTH_ENABLED=false

# Public hostname used for the Open Graph image (no protocol).
# VITE_PUBLIC_HOSTNAME=lilrons.example.com
